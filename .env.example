# Set di Netlify: Site configuration > Environment variables. JANGAN commit file .env asli.
# Wajib: string acak panjang (>=32 karakter) untuk menandatangani session & ticket.
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Opsional (relay TURN supaya pemain beda jaringan bisa terhubung) - dari dashboard Metered.
METERED_APP=
METERED_API_KEY=
